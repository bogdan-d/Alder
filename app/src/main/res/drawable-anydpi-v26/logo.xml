<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 8+. Google TV crops icons to a circle and shows transparency as white, so the logo sits on the banner's dark background, inset to the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <color android:color="#FF0E0C0A" />
    </background>
    <foreground>
        <inset android:drawable="@drawable/logo_foreground" android:inset="14%" />
    </foreground>
</adaptive-icon>
